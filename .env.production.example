# ─────────────────────────────────────────────────────────────────────────────
# .env.production.example
#
# On your Hetzner server:
#   cp .env.production.example .env.production
#   nano .env.production        ← fill in every value marked [CHANGE ME]
#
# NEVER commit .env.production to git. It is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Domain (used by nginx and baked into React bundle) ───────────────────────
# Set this to the domain you point at the Hetzner server IP
VITE_API_URL=https://aischoolonair.com        # [CHANGE ME] — your domain

# ── Database (points to the postgres Docker service) ─────────────────────────
DB_USER=eduuser
DB_NAME=edu_platform
DB_PASSWORD=change_me_strong_password_here    # [CHANGE ME] — generate with: openssl rand -hex 32
DB_PORT=5432
DB_LOGGING=false

# DATABASE_URL is auto-composed in docker-compose.yml from DB_* vars above.
# Only override here if you are using an EXTERNAL database (e.g. keeping Render DB).
# DATABASE_URL=postgresql://eduuser:PASSWORD@postgres:5432/edu_platform

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_long_random_string       # [CHANGE ME] — generate with: openssl rand -hex 64
JWT_EXPIRE=7d

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...                      # [CHANGE ME]
GEMINI_MODEL=gemini-2.5-flash

# ── Payments ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_...               # [CHANGE ME] — use live key in production
PAYSTACK_PUBLIC_KEY=pk_live_...               # [CHANGE ME]
PAYSTACK_WEBHOOK_SECRET=                      # [CHANGE ME] — from Paystack dashboard

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=info@eac.edu.ng                    # [CHANGE ME]
EMAIL_PASS=your_gmail_app_password            # [CHANGE ME] — Gmail App Password (not your login password)
EMAIL_FROM=AISchoolonair <noreply@aischoolonair.com>

# ── CORS / Frontend URLs ──────────────────────────────────────────────────────
CLIENT_URL=https://aischoolonair.com          # [CHANGE ME]
PROD_CLIENT_URL=https://aischoolonair.com     # [CHANGE ME]
SERVER_BASE_URL=https://aischoolonair.com     # [CHANGE ME]

# ── Redis (points to the redis Docker service) ────────────────────────────────
# REDIS_URL is overridden in docker-compose.yml to use the internal service.
# Only set this if using external Redis (e.g. Upstash).
# REDIS_URL=redis://redis:6379

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ── Video / HLS ───────────────────────────────────────────────────────────────
HLS_BASE=/app/uploads/videos/hls
FFMPEG_PATH=/usr/bin/ffmpeg
