# ── Database dumps & large files ─────────────────────────────────────────────
*.dump
*_dump.sql
*_dump.txt
*.sql
*.txt
*.zip
*.tar
*.gz

# Migrations are intentionally tracked despite the blanket *.sql rule above —
# gitignore evaluates patterns in order and the LAST match wins, so this
# exception must come AFTER *.sql, not before it (a previous attempt at this
# same exception was placed before the blanket rule, which meant it never
# actually took effect — *.sql, coming later, always won). Without this
# working correctly, a plain `git add`/`git add .` silently drops any new
# database/migration_*.sql file with no error (this is exactly how Phase 5's
# migration_009 file went missing from commit 7564b10, and why the original
# attempt at this fix still required force-adding migration_009 by hand).
!database/migration_*.sql
# Same exemption for the one-off read-only audit script — not a migration
# (changes nothing), but same *.sql-blanket-rule trap applies to any new
# database/*.sql file, not just migration_*.sql ones.
!database/audit_missing_column_defaults.sql
# Same exemption for the diagnostics/ directory — reusable, version-
# controlled read-only check scripts (Prompts 1 & 3, Batch 3). Not
# migrations, but the same blanket *.sql trap applies to any new
# database/*.sql file regardless of subdirectory.
!database/diagnostics/*.sql

database/*.dump
code_dump_fresh.txt

