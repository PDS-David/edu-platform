# ═══════════════════════════════════════════════════════════════════════════════
# AISchoolonair — Caddy reverse-proxy  (production + staging)
# ═══════════════════════════════════════════════════════════════════════════════

{
    email admin@aischoolonair.ng
    admin off

    servers {
        trusted_proxies static private_ranges
        # Disable HTTP/3 (QUIC) — prevents ERR_QUIC_PROTOCOL_ERROR when
        # browsers try to reuse a cached QUIC connection after a restart.
        protocols h1 h2
    }
}

# ── Shared security headers ───────────────────────────────────────────────────
(security_headers) {
    header {
        Strict-Transport-Security  "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options     "nosniff"
        X-Frame-Options            "SAMEORIGIN"
        Referrer-Policy            "strict-origin-when-cross-origin"
        Permissions-Policy         "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy    "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' wss://www.aischoolonair.ng wss://staging.aischoolonair.ng https://api.paystack.co; frame-src 'self' https://docs.google.com; object-src 'none'; upgrade-insecure-requests"
        -Server
        -Alt-Svc
    }
}

# ── Redirect bare domain → www ────────────────────────────────────────────────
aischoolonair.ng {
    redir https://www.aischoolonair.ng{uri} permanent
}

# ── Production ────────────────────────────────────────────────────────────────
www.aischoolonair.ng {
    import security_headers

    # Paystack webhook
    @webhook path /api/payments/webhook
    route @webhook {
        reverse_proxy http://api:5000 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP       {remote_host}
        }
    }

    # WebSocket (FIXED — scoped correctly)
    @ws {
        header Connection *Upgrade*
        header Upgrade websocket
        path /socket.io/*
    }
    route @ws {
        reverse_proxy http://api:5000 {
            transport http {
                read_timeout 60s
            }
        }
    }

    # REST API
    @api path /api/*
    route @api {
        reverse_proxy http://api:5000 {
            transport http {
                read_timeout  120s
                write_timeout 120s
            }
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP       {remote_host}
        }
    }

    # Uploads
    @uploads path /uploads/*
    route @uploads {
        reverse_proxy http://api:5000 {
            transport http {
                read_timeout 60s
            }
        }
    }

    # Frontend — serve from nginx container.
    # index.html is served with no-cache headers by nginx (nginx-spa.conf).
    # We do not add Caddy-level cache headers here — nginx handles it correctly
    # and double-setting headers causes conflicts.
    route {
        reverse_proxy web:80
        encode gzip zstd
    }
}

# ── Staging ───────────────────────────────────────────────────────────────────
staging.aischoolonair.ng {
    import security_headers

    @webhook_stg path /api/payments/webhook
    route @webhook_stg {
        reverse_proxy http://api_staging:5000 {
            header_up X-Forwarded-For {remote_host}
        }
    }

    @ws_stg {
        header Connection *Upgrade*
        header Upgrade websocket
        path /socket.io/*
    }
    route @ws_stg {
        reverse_proxy http://api_staging:5000 {
            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    @api_stg path /api/*
    route @api_stg {
        reverse_proxy http://api_staging:5000 {
            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    @uploads_stg path /uploads/*
    route @uploads_stg {
        reverse_proxy http://api_staging:5000
    }

    route {
        reverse_proxy web_staging:80
        encode gzip zstd
    }
}
