# ═══════════════════════════════════════════════════════════════════════════════
# api.env.example — Production env template for Hetzner deployment
#
# USAGE:
#   On the server:  cp api.env.example api.env
#                   nano api.env      ← fill every REPLACE_ME value
# NEVER commit api.env to git.  It is in .gitignore.
#
# For staging:  cp api.env.example api.staging.env && nano api.staging.env
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
LOG_LEVEL=http

# ── Database (Render Postgres) ────────────────────────────────────────────────
# Copy the "External Database URL" from Render → your DB → Info tab.
# Must include ?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Redis (internal Docker service — do not change host) ─────────────────────
REDIS_URL=redis://redis:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_ME_64_CHAR_HEX
JWT_EXPIRE=7d
SESSION_SECRET=REPLACE_ME_ANOTHER_64_CHAR_HEX

# ── Auth Hardening (AUTH-001 → AUTH-005) ──────────────────────────────────────
# Account lockout: failed attempts before lock, and lock duration in minutes
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Session inactivity timeout in seconds (default: 4 hours = 14400)
AUTH_INACTIVITY_TTL_SECONDS=14400

# ── CORS / Client URLs ────────────────────────────────────────────────────────
# These must exactly match the origin header sent by the browser.
CLIENT_URL=https://www.aischoolonair.ng
PROD_CLIENT_URL=https://aischoolonair.ng
SERVER_BASE_URL=https://www.aischoolonair.ng

# ── Payments (Paystack) ───────────────────────────────────────────────────────
# Production: sk_live_...   Staging: sk_test_...
PAYSTACK_SECRET_KEY=REPLACE_ME
# Found in Paystack Dashboard → Settings → API Keys & Webhooks → Webhook secret
PAYSTACK_WEBHOOK_SECRET=REPLACE_ME

# ── Email (Gmail SMTP or any SMTP provider) ───────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=REPLACE_ME@gmail.com
# For Gmail: generate an App Password (not your login password)
# https://myaccount.google.com/apppasswords
EMAIL_PASS=REPLACE_ME
EMAIL_FROM=AISchoolonair <noreply@aischoolonair.ng>

# ── AI / Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-2.5-flash-lite

# ── File Storage ─────────────────────────────────────────────────────────────
# Hetzner: local Docker volume (uploads_data) is persistent — set this to true.
# Render:  local disk is ephemeral — leave false and configure R2 instead.
ALLOW_LOCAL_UPLOADS=true

# ── Cloudflare R2 (optional — use instead of local storage for CDN delivery) ──
# Steps:
#   1. Cloudflare dashboard → R2 → Create bucket (e.g. aischoolonair-uploads)
#   2. R2 → Manage R2 API Tokens → Create token with Object Read & Write
#   3. Enable "Public access" on the bucket and copy the r2.dev URL
#   4. Optionally point a custom domain (e.g. cdn.aischoolonair.ng → bucket)
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET=aischoolonair-uploads
# Public bucket URL — enables Google Docs Viewer previews for office files.
# Use the r2.dev URL shown on the bucket page, or your custom CDN domain.
R2_PUBLIC_BASE_URL=https://pub-REPLACE_ME.r2.dev

# ── Rate limits ───────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ── Misc ──────────────────────────────────────────────────────────────────────
DB_LOGGING=false
ADMIN_WHITELIST_IPS=
