# ─────────────────────────────────────────────────────────────────────────────
# api.env.example  —  copy to api.env and fill in real values
# NEVER commit api.env to git (it's in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
LOG_LEVEL=http

# ── Database (Render Postgres — copy from Render dashboard) ──────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Redis (internal Docker service) ──────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_64_CHARS
SESSION_SECRET=REPLACE_WITH_ANOTHER_STRONG_SECRET

# ── Cloudflare R2 (copy from Render env vars) ────────────────────────────────
R2_ACCOUNT_ID=82d65b797005eaecf399906613fa60d2
R2_ACCESS_KEY_ID=REPLACE
R2_SECRET_ACCESS_KEY=REPLACE
R2_BUCKET=aischoolonair-uploads
R2_PUBLIC_BASE_URL=https://cdn.aischoolonair.ng

# ── Client URL (for CORS / email links) ──────────────────────────────────────
CLIENT_URL=https://www.aischoolonair.ng
PROD_CLIENT_URL=https://aischoolonair.ng

# ── Email (optional) ─────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@aischoolonair.ng

# ── AI (optional — used by AI question generation) ───────────────────────────
GEMINI_API_KEY=REPLACE_IF_USED
OPENAI_API_KEY=REPLACE_IF_USED

# ── Payments (optional) ───────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=REPLACE_IF_USED
