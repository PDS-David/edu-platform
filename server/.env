# ─────────────────────────────────────────────────────────────────────────────
# AISchoolonair — server environment variables
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=http
# Comma-separated IPs allowed to access admin routes (leave blank to allow all)
# ADMIN_WHITELIST_IPS=

# ── Database (individual fields — used by config/database.js) ─────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edu_platform
DB_USER=postgres
DB_PASSWORD=FCE9kxx9a8baqrn38PPAeobPvwY7mOTd
DB_POOL_MIN=0
DB_POOL_MAX=5
# Set to 'true' to log all Sequelize SQL queries (dev only)
DB_LOGGING=false
# Optional: full connection string (overrides individual DB_* fields if set)
DATABASE_URL=postgresql://eduuser:FCE9kxx9a8baqrn38PPAeobPvwY7mOTd@dpg-d7auo44hg0os73a462og-a.frankfurt-postgres.render.com/edu_platform_3kh7
# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=10feb489dc959da91e4a7195ec58bbe58b6196b03b085b8fb4948fc468e86fa3cf6edb93564f605007a4a8bf9e2bdd7b
JWT_EXPIRES_IN=7d

# ── AI Providers ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSyC4NfBtyK6IxC3trsdlpf-QF-PY26CuKJ8
# Optional: override the default Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Optional: enables Claude for complex_reasoning tasks with Gemini fallback
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis-cli --tls -u redis://default:gQAAAAAAAX1-AAIncDE5MWJhYzcwZmQ3NjQ0NTY0YTlhOGVlZWUyZjUyZjY4YnAxOTc2NjI@wondrous-badger-97662.upstash.io:6379

# ── CORS / URLs ───────────────────────────────────────────────────────────────
# Local frontend dev server
CLIENT_URL=http://localhost:5173
# Production frontend URL
PROD_CLIENT_URL=https://yourapp.com
# Public base URL of this server (used in email links, webhooks, etc.)
SERVER_BASE_URL=http://localhost:5000

# ── Streaming ─────────────────────────────────────────────────────────────────
# Set to 'true' to enable SSE streaming on /api/ai/chat/stream
ENABLE_STREAMING=false

# ── Payments (Paystack) ───────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_e2ad9744b53928720b90c06ff10fed5e08b70bfe
# Optional: separate webhook secret (falls back to PAYSTACK_SECRET_KEY if unset)
# PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here

# ── Email (Nodemailer / Gmail SMTP) ───────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Set to 'true' for port 465 (SSL), 'false' for port 587 (STARTTLS)
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
# Use a Gmail App Password, not your account password
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM=AISchoolonair <noreply@yourapp.com>

# ── Video / HLS ───────────────────────────────────────────────────────────────
HLS_BASE=/var/www/videos
ENCRYPTION_KEY=b283d14a1e1395e4e9d84110c6a5634b7dc74c9447ba6e1526597d742f4c479d
