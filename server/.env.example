# =============================================================================
# AISchoolonair — Environment Variables
# Copy this file to .env and fill in your values (never commit .env)
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Individual DB vars (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edu_platform
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_LOGGING=false
DB_POOL_MAX=5
DB_POOL_MIN=0

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_minimum_32_chars_here
JWT_EXPIRE=7d

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ENABLE_STREAMING=false

# ── Redis (leave blank on Render free tier) ───────────────────────────────────
REDIS_URL=

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# ── Payments ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM=AISchoolonair <noreply@aischoolonair.com>

# ── URLs ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
PROD_CLIENT_URL=https://aischoolonair.onrender.com
SERVER_BASE_URL=http://localhost:5000
NGROK_URL=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_WHITELIST_IPS=

# ── Video (optional — for HLS encryption) ────────────────────────────────────
HLS_BASE=/var/www/videos
ENCRYPTION_KEY=your_32char_hex_encryption_key_here
FFMPEG_PATH=/usr/bin/ffmpeg
