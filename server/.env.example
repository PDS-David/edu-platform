# =============================================================================
# AISchoolonair — Environment Variables
# Copy this file to .env and fill in your values (never commit .env)
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Never commit real credentials. Use placeholders here and set real values in
# your runtime environment (.env locally, api.env on the Hetzner server).
# Supabase transaction pooler (port 6543) — use this for production:
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Supabase session pooler (port 5432) — use for local dev / migrations:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DB_LOGGING=false
DB_POOL_MAX=5
DB_POOL_MIN=0

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRE=7d

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=REPLACE_IF_USED
GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Second AI provider (server/services/ai.js's generate() supports
# provider: 'openai'/'chatgpt' alongside the default 'gemini'). Not a free
# ongoing API — a new OpenAI account gets a small one-time trial credit,
# then it's pay-per-token like any other provider. Leave unset to disable
# the openai/chatgpt provider option entirely; every existing call site
# that doesn't pass `provider` is unaffected either way.
OPENAI_API_KEY=REPLACE_IF_USED
ENABLE_STREAMING=false

# Shared secret for POST /agent/generate (server/middleware/agentServiceAuth.js)
# — the server-to-server endpoint that lets sts-school-app (Brainee) use this
# app's generate() (both Gemini and OpenAI providers) instead of running its
# own duplicate AI integration. Generate a long random string and set the
# SAME value as AI_AGENT_SERVICE_KEY on the sts-school-app backend. Leave
# unset to disable the endpoint entirely (it fails closed with 503 when this
# is unset — see agentServiceAuth.js).
AI_AGENT_SERVICE_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# ── Payments ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=REPLACE_IF_USED
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
# PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=REPLACE_IF_USED
EMAIL_FROM=AISchoolonair <noreply@aischoolonair.com>

# ── URLs ──────────────────────────────────────────────────────────────────────
CLIENT_URL=https://www.aischoolonair.ng
PROD_CLIENT_URL=https://aischoolonair.ng
SERVER_BASE_URL=https://www.aischoolonair.ng

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ── Admin ─────────────────────────────────────────────────────────────────────
# ADMIN_WHITELIST_IPS=

# ── Video (optional — for HLS encryption) ────────────────────────────────────
HLS_BASE=/var/www/videos
ENCRYPTION_KEY=your_32char_hex_encryption_key_here
FFMPEG_PATH=/usr/bin/ffmpeg
