# ─────────────────────────────────────────────────────────────────────────────
# AISchoolonair — Environment Variables
# Copy this file to .env and fill in all required values before starting.
# NEVER commit the real .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production          # development | production
PORT=5000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edu_platform
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here   # REQUIRED — server will not start without this
DB_LOGGING=true             # set to true to log every SQL query (dev only)

# ── Connection pool (optional — defaults: max=20 prod / max=5 dev) ───────────
# DB_POOL_MAX=20
# DB_POOL_MIN=0

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED — must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRE=7d

# ── Payments (Paystack) ───────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here   # REQUIRED
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here

# ── AI (Google Gemini) ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM="EAC Learning <noreply@eaclearning.com>"

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173          # local frontend dev server
PROD_CLIENT_URL=https://your-app.com     # production frontend URL

# ── Rate limiting (optional — defaults shown) ─────────────────────────────────
# RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
# RATE_LIMIT_MAX_REQUESTS=100
