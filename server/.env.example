# ============================================================
# EAC LEARNING PLATFORM — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edu_platform
DB_USER=postgres
DB_PASSWORD=your_password_here

# Alternative: single connection string
# DATABASE_URL=postgresql://username:password@localhost:5432/edu_platform

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ── CORS ─────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
PROD_CLIENT_URL=https://your-production-domain.com

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# ── File Upload ───────────────────────────────────────────────
MAX_FILE_SIZE=524288000
UPLOAD_PATH=./uploads

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── AI — Google Gemini ────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Payments — Paystack ───────────────────────────────────────
# Get your keys at: https://dashboard.paystack.com/#/settings/developers
# Secret key goes here (server only — NEVER expose to client)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here

# ── Frontend note ─────────────────────────────────────────────
# The Paystack PUBLIC key goes in client/.env as:
# VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here
# The Gemini API key is server-side only — never put it in client/.env
