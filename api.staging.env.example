# ═══════════════════════════════════════════════════════════════════════════════
# api.staging.env.example — Staging env template (staging.aischoolonair.ng)
#
# USAGE:
#   cp api.staging.env.example api.staging.env
#   nano api.staging.env   ← fill every REPLACE_ME
# NEVER commit api.staging.env to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
LOG_LEVEL=debug

# ── Database — same Render Postgres as prod (or a separate staging DB) ────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Redis (shared internal Docker service) ────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_ME_64_CHAR_HEX
JWT_EXPIRE=7d
SESSION_SECRET=REPLACE_ME_ANOTHER_64_CHAR_HEX

# ── CORS / Client URLs ────────────────────────────────────────────────────────
CLIENT_URL=https://staging.aischoolonair.ng
PROD_CLIENT_URL=https://staging.aischoolonair.ng
SERVER_BASE_URL=https://staging.aischoolonair.ng

# ── Payments — USE TEST KEYS ONLY on staging ──────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_WEBHOOK_SECRET=REPLACE_ME

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=REPLACE_ME@gmail.com
EMAIL_PASS=REPLACE_ME
EMAIL_FROM=AISchoolonair Staging <noreply@aischoolonair.ng>

# ── AI / Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET=aischoolonair-uploads-staging
R2_PUBLIC_BASE_URL=https://pub-REPLACE_ME.r2.dev

# ── Rate limits ───────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ── Misc ──────────────────────────────────────────────────────────────────────
DB_LOGGING=true
ADMIN_WHITELIST_IPS=
